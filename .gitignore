# Keep the public repository focused on runnable source and the manuscript.
# Root-level Markdown files are working notes unless explicitly allowlisted.
/*.md
!/README.md
!/AGENTS.md
# Publish protocols and result reports; keep local handoffs and drafts.
/docs/thesis/*
!/docs/thesis/README.md
!/docs/thesis/OVERLEAF_COMPILE_GUIDE.md
!/docs/thesis/PREDECODER_METHOD_DESCRIPTION.md
!/docs/thesis/PREDECODER_RESEARCH_INTEGRITY_AUDIT.md
!/docs/thesis/PREDECODER_INDEPENDENT_REVALIDATION.md
!/docs/thesis/PREDECODER_NOISE_SHIFT_EXPERIMENT_PLAN.md
!/docs/thesis/PREDECODER_PAPER_EVIDENCE.md
!/docs/thesis/PREDECODER_D7_*_PROTOCOL.md
!/docs/thesis/results/
/docs/thesis/results/*
!/docs/thesis/results/*.md
/.local/
/graphify-out/

# Personal root-level text files (requirements remains part of the project).
/*.txt
!/requirements.txt

# Historical prototypes remain available locally but are not published.
/legacy_archive/

